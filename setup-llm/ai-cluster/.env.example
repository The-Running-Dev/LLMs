# Copy to .env before starting the AI cluster.
# Keep .env out of source control.

# Gateway auth used by OpenAI-compatible clients.
LITELLM_MASTER_KEY=replace_me_litellm_master_key

# Open WebUI hardening defaults.
WEBUI_SECRET_KEY=replace_me_open_webui_secret_key
WEBUI_AUTH=true
WEBUI_SESSION_COOKIE_SAME_SITE=strict
WEBUI_SESSION_COOKIE_SECURE=false
WEBUI_AUTH_COOKIE_SAME_SITE=strict
WEBUI_AUTH_COOKIE_SECURE=false
DEFAULT_USER_ROLE=pending
ENABLE_PERSISTENT_CONFIG=false

# Host bind port for the LiteLLM gateway.
GATEWAY_BIND_PORT=4000

# Shared key for local inference backends.
LOCAL_INFERENCE_API_KEY=replace_me_local_inference_key

# Host-native inference endpoints for the first Windows Arc B580 spike.
# These defaults assume local llama-server instances on ports 8081 and 8082.
LOCAL_CODING_BASE_URL=http://host.docker.internal:8081/v1
LOCAL_EMBEDDINGS_BASE_URL=http://host.docker.internal:8082/v1

# Optional cloud route switch for a future provider profile.
ENABLE_CLOUD_FALLBACK=0

# Optional coding route override used in provider-switch tests.
# LOCAL_CODING_BASE_URL=http://coding-backend-alt:8083/v1
